# Copy to .env (gitignored) on the Docker host only. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

HINDSIGHT_VERSION=1.1.0

# Address the ports bind to on the Docker host.
#   127.0.0.1  -> local only; expose to the tailnet with `tailscale serve` (recommended)
#   <LAN IP>   -> LAN clients connect directly; firewall it (see README)
HINDSIGHT_BIND_IP=127.0.0.1

HINDSIGHT_DB_PASSWORD=change-me
# Shared bearer key for API + MCP. Both dev machines use this value.
HINDSIGHT_API_KEY=change-me
# Password for the Control Plane UI (port 9999).
HINDSIGHT_UI_ACCESS_KEY=change-me

# Optional: override the MCP tool allowlist set in compose.yaml (comma-separated).
# HINDSIGHT_MCP_ENABLED_TOOLS=

# LLM Hindsight uses internally. `none` works without a key (no fact extraction, no reflect).
HINDSIGHT_API_LLM_PROVIDER=none
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_MODEL=
